<%- include('../partials/head', { title: 'Browse Items - Campus Lost & Found' }) %>
<%- include('../partials/navbar') %>

<main class="container pb-5">

  <div class="p-4 mb-4 bg-white rounded shadow-sm">
    <form method="GET" action="/items" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Search</label>
        <input type="text" name="q" value="<%= filters.q %>" class="form-control" placeholder="Title, description, location...">
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Type</label>
        <select name="type" class="form-select">
          <option value="" <%= filters.type === '' ? 'selected' : '' %>>All</option>
          <option value="lost" <%= filters.type === 'lost' ? 'selected' : '' %>>Lost</option>
          <option value="found" <%= filters.type === 'found' ? 'selected' : '' %>>Found</option>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Category</label>
        <select name="category" class="form-select">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Status</label>
        <select name="status" class="form-select">
          <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open</option>
          <option value="resolved" <%= filters.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i></button>
      </div>
    </form>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><%= items.length %> item<%= items.length !== 1 ? 's' : '' %> found</h5>
  </div>

  <% if (items.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
      <p class="mt-2">No items match your filters. Try adjusting your search.</p>
    </div>
  <% } %>

  <div class="row g-4">
    <% items.forEach(item => { %>
      <div class="col-md-4 col-lg-3">
        <a href="/items/<%= item.id %>" class="text-decoration-none text-dark">
          <div class="card item-card h-100">
            <% if (item.image_path) { %>
              <img src="<%= item.image_path %>" class="card-img-top" alt="<%= item.title %>">
            <% } else { %>
              <div class="placeholder-icon">
                <i class="bi bi-image"></i>
              </div>
            <% } %>
            <div class="card-body">
              <div class="mb-2">
                <span class="badge <%= item.type === 'lost' ? 'badge-lost' : 'badge-found' %>">
                  <%= item.type === 'lost' ? 'LOST' : 'FOUND' %>
                </span>
                <% if (item.status === 'resolved') { %>
                  <span class="badge bg-secondary">Resolved</span>
                <% } %>
              </div>
              <h6 class="card-title mb-1"><%= item.title %></h6>
              <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> <%= item.location %></p>
              <p class="text-muted small mb-0"><i class="bi bi-calendar"></i> <%= item.event_date %></p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>
</main>

<%- include('../partials/footer') %>

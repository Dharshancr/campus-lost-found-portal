<%- include('../partials/head', { title: 'My Posts - Campus Lost & Found' }) %>
<%- include('../partials/navbar') %>

<main class="container pb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-person-lines-fill"></i> My Posted Items</h4>
    <a href="/items/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle"></i> Post New Item</a>
  </div>

  <% if (items.length === 0) { %>
    <div class="text-center py-5 text-muted">
      <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
      <p class="mt-2">You haven't posted any items yet.</p>
      <a href="/items/new" class="btn btn-primary btn-sm mt-2">Post your first item</a>
    </div>
  <% } %>

  <% items.forEach(item => { %>
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <span class="badge <%= item.type === 'lost' ? 'badge-lost' : 'badge-found' %>">
              <%= item.type === 'lost' ? 'LOST' : 'FOUND' %>
            </span>
            <% if (item.status === 'resolved') { %>
              <span class="badge bg-secondary">Resolved</span>
            <% } %>
            <h5 class="mt-2 mb-1"><a href="/items/<%= item.id %>" class="text-decoration-none"><%= item.title %></a></h5>
            <p class="text-muted small mb-0"><i class="bi bi-geo-alt"></i> <%= item.location %> &middot; <i class="bi bi-calendar"></i> <%= item.event_date %></p>
          </div>
          <div class="d-flex gap-2">
            <% if (item.status === 'open') { %>
              <form method="POST" action="/items/<%= item.id %>/resolve">
                <button class="btn btn-success btn-sm">Mark Resolved</button>
              </form>
            <% } %>
            <form method="POST" action="/items/<%= item.id %>/delete" onsubmit="return confirm('Delete this post permanently?');">
              <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i></button>
            </form>
          </div>
        </div>

        <% const itemClaims = claimsByItem[item.id] || []; %>
        <% if (itemClaims.length > 0) { %>
          <hr>
          <h6 class="small text-muted mb-2">CLAIMS RECEIVED (<%= itemClaims.length %>)</h6>
          <% itemClaims.forEach(claim => { %>
            <div class="border rounded p-2 mb-2 bg-light">
              <div class="d-flex justify-content-between">
                <strong class="small"><%= claim.claimer_name %></strong>
                <span class="text-muted small"><%= new Date(claim.created_at).toLocaleDateString() %></span>
              </div>
              <p class="mb-1 small"><%= claim.message %></p>
              <p class="mb-0 small text-primary">
                <i class="bi bi-envelope"></i> <%= claim.claimer_email %>
                <% if (claim.claimer_phone) { %> &middot; <i class="bi bi-telephone"></i> <%= claim.claimer_phone %><% } %>
              </p>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  <% }) %>
</main>

<%- include('../partials/footer') %>

<%- include('partials/head', { title: 'Sign Up - Campus Lost & Found' }) %>
<%- include('partials/navbar') %>

<main class="container">
  <div class="card auth-card p-4">
    <div class="text-center mb-3">
      <i class="bi bi-person-plus fs-1 text-primary"></i>
      <h3 class="mt-2">Create an Account</h3>
      <p class="text-muted small">Join to post and claim lost/found items</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger py-2"><%= error %></div>
    <% } %>

    <form method="POST" action="/register">
      <div class="mb-3">
        <label class="form-label">Full Name</label>
        <input type="text" name="name" class="form-control" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Phone</label>
        <input type="tel" name="phone" class="form-control" placeholder="For claimants to reach you" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" minlength="6" required>
      </div>
      <button type="submit" class="btn btn-primary w-100">Sign Up</button>
    </form>

    <p class="text-center mt-3 mb-0 small">
      Already have an account? <a href="/login">Login</a>
    </p>
  </div>
</main>

<%- include('partials/footer') %>
